# ============================================
# DATABASE (PostgreSQL محلی)
# ============================================
DATABASE_URL=postgresql://kargah:kargah_dev_pass@localhost:5432/kargah

# ============================================
# UPLOADS (دیسک محلی)
# ============================================
UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_URL=http://localhost:3001/uploads

# ============================================
# NLP SERVICE
# ============================================
NLP_SERVICE_URL=http://localhost:8000

# ============================================
# AUTH
# ============================================
JWT_SECRET=dev_secret_32_chars_minimum_abcdefgh
JWT_EXPIRES_IN=24h

# ============================================
# APP
# ============================================
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000
APP_SECRET=dev_hmac_secret_32_chars_minimum_xyz

# ============================================
# Gamification defaults
# ============================================
XP_DAILY_SOFT_CAP=600
XP_DAILY_HARD_CAP=1000
STREAK_FREEZE_MAX=2
REROLL_DAILY_LIMIT=2

# ============================================
# Integrity thresholds
# ============================================
PASTE_THRESHOLD=0.20
TYPING_SPEED_MAX=12
VOCAB_UNIQUE_MIN=0.30
KNOWN_WORD_MIN=0.60
SELF_SIMILARITY_MAX=0.90
BANK_SIMILARITY_MAX=0.80
